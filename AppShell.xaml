<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HarryPotterPotions.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HarryPotterPotions"
    xmlns:views="clr-namespace:HarryPotterPotions.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="HarryPotterPotions">

    

    <TabBar>
        <Tab Title="Search Potions">
            <ShellContent
                Title="One"
                ContentTemplate="{DataTemplate views:MainPage}"
                Route="OnePage" />
        </Tab>
        <Tab Title="Shopping List">
            <ShellContent
                Title="Two"
                ContentTemplate="{DataTemplate views:ShoppingListPage}"
                Route="ShoppingListPage" />
        </Tab>
        <Tab Title="Inventory">
            <ShellContent
                Title="Three"
                ContentTemplate="{DataTemplate views:IngredientInventoryPage}"
                Route="ThreePage" />
        </Tab>
        <Tab Title="Preferences">
            <ShellContent
                Title="Four"
                ContentTemplate="{DataTemplate views:PreferencesPage}"
                Route="FourPage" />
        </Tab>
    </TabBar>

