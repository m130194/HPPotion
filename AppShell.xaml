<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HarryPotterPotions.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HarryPotterPotions"
    xmlns:views="clr-namespace:HarryPotterPotions.Views"
    FlyoutBehavior="Flyout"
    Title="HarryPotterPotions">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="Shopping List"
        ContentTemplate="{DataTemplate views:ShoppingListPage}"
        Route="ShoppingList" />
    <ShellContent
        Title="Ingredient Inventory"
        ContentTemplate="{DataTemplate views:IngredientInventoryPage}"
        Route="IngredientInventory" />
    <ShellContent
    Title="User Preferences"
    ContentTemplate="{DataTemplate views:PreferencesPage}"
    Route="UserPreferences" />

</Shell>
