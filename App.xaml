<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:HarryPotterPotions"
             x:Class="HarryPotterPotions.App"
             xmlns:viewmodel="clr-namespace:HarryPotterPotions.ViewModels"
             x:DataType="viewmodel:AppViewModel">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <x:Double x:Key="GlobalFontSize">14</x:Double>
    </Application.Resources>
</Application>
