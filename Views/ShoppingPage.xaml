<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HarryPotterPotions.Views.ShoppingListPage"
             xmlns:viewmodel="clr-namespace:HarryPotterPotions.ViewModels"
             xmlns:model="clr-namespace:HarryPotterPotions.Models"
             x:DataType="viewmodel:ShoppingViewModel"
             x:Name="ThisShoppingListPage"
             Title="Shopping List">

    <ScrollView>
        <Grid RowDefinitions="50,*,100"
            ColumnDefinitions="*,*">
<Label Text="Ingredients Available to Buy" Grid.Column="0" Grid.Row="0"/>
            <CollectionView ItemsSource="{Binding Ingredients}" Grid.Column="0" Grid.Row="1">
                <CollectionView.EmptyView>
                    <Label Text="No items in shopping list." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Ingredient">

                        <Grid RowDefinitions="50,*"
                                ColumnDefinitions="*,50,100"
                                RowSpacing="10"
                                ColumnSpacing="10"
                                Margin="10"
                                Padding="10">
                            
                            <Label Text="{Binding Name}" VerticalOptions="Center" Grid.Column="0" Grid.Row="1"/>
                            <Label Text="{Binding IngredientPrice, StringFormat='$ {0:F2}'}" Grid.Column="1" Grid.Row="1" />
                            <Button Text="Add to Cart" Command="{Binding Source={x:Reference ThisShoppingListPage}, Path=BindingContext.HandleIngredientClickedAddCommand}" CommandParameter="{Binding .}" Grid.Column="2" Grid.Row="1"/>
                            

                        </Grid>




                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


<Label Text="Shopping Cart" Grid.Column="1" Grid.Row="0"/>
            <CollectionView ItemsSource="{Binding ShoppingCart}" Grid.Column="1" Grid.Row="1">
                <CollectionView.EmptyView>
                    <Label Text="No items in shopping cart." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Item">
                        <Grid RowDefinitions="*,50"
                                ColumnDefinitions="*,50,80,100"
                                RowSpacing="10"
                                ColumnSpacing="10"
                                Margin="10"
                                Padding="10">
                            
                            <Label Text="{Binding Ingredient.Name}" VerticalOptions="Center" Grid.Column="0" Grid.Row="0"/>
                            <Label Text="{Binding Quantity}" Grid.Column="1" Grid.Row="0"/>
                            <Label Text="{Binding ItemPrice, StringFormat='$ {0:F2}'}" Grid.Column="2" Grid.Row="0"/>
                            <Button Text="Delete" BackgroundColor="Red" Command="{Binding Source={x:Reference ThisShoppingListPage}, Path=BindingContext.ButtonDeleteItemFromShoppingCartCommand}" CommandParameter="{Binding .}" Grid.Column="3" Grid.Row="0"/>
                            <!--<Button Text="Add All To Inventory" BackgroundColor="Green" Command="{Binding Source={x:Reference ThisShoppingListPage}, Path=BindingContext.ButtonAddItemsToInventoryCommand}" CommandParameter="{Binding .}" Grid.Column="0" Grid.Row="1"/>-->
                        
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
<Label Text="{Binding Source={x:Reference ThisShoppingListPage}, Path=BindingContext.TotalCartPrice, StringFormat='$ {0:F2}'}" Grid.Column="1" Grid.Row="3"/>
        </Grid>
    </ScrollView>
</ContentPage>