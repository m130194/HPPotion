<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HarryPotterPotions.Views.ShoppingListPage"
             xmlns:viewmodel="clr-namespace:HarryPotterPotions.ViewModels"
             xmlns:model="clr-namespace:HarryPotterPotions.Models"
             x:DataType="viewmodel:ShoppingListViewModel"
             x:Name="ThisShoppingListPage"
             Title="Shopping List">



    <ScrollView>
        <VerticalStackLayout>
        <CollectionView ItemsSource="{Binding SavedPotionsToMake}">
            <CollectionView.EmptyView>
                <Label Text="No saved potions." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Potion">
                    <VerticalStackLayout>
                        <Label Text="{Binding Name}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView ItemsSource="{Binding ShoppingList}">
            <CollectionView.EmptyView>
                <Label Text="No items in shopping list." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <!--<SwipeView>
                        <SwipeView.LeftItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete" BackgroundColor="Red" Command="{Binding Source={x:Reference WhatsThisShoppingListPage}, Path=BindingContext.ButtonDeleteIngredientCommand}" CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.LeftItems>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Add to Inventory" BackgroundColor="Purple" Command="{Binding Source={x:Reference WhatsThisShoppingListPage}, Path=BindingContext.ButtonAddIngredientToInventoryCommand}" CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                    </SwipeView>-->
                    <Grid RowDefinitions="*"
      ColumnDefinitions="*,3*,*"
      RowSpacing="10"
      ColumnSpacing="10"
      Margin="10"
      Padding="10">

                    
                    
                        <CheckBox Command="{Binding Source={x:Reference ThisShoppingListPage}, Path=BindingContext.ButtonAddIngredientToInventoryCommand}" CommandParameter="{Binding .}" Grid.Column="0" Grid.Row="0"/>
                                <Label Text="{Binding .}" VerticalOptions="Center" Grid.Column="1" Grid.Row="0"/>
                            <Button Text="Delete" BackgroundColor="Red" Command="{Binding Source={x:Reference ThisShoppingListPage}, Path=BindingContext.ButtonDeleteIngredientCommand}" CommandParameter="{Binding .}" Grid.Column="2" Grid.Row="0"/>
                                

                    
                        </Grid>
                    <!--</SwipeView-->



                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


    </VerticalStackLayout>
        </ScrollView>
</ContentPage>