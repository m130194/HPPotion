<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ViewModels="clr-namespace:HarryPotterPotions.ViewModels"
             x:Class="HarryPotterPotions.Views.PreferencesPage"
             
             Title="PreferencesPage">
    <ScrollView>
        <VerticalStackLayout>
            <!-- Sample Label whose font size changes -->
            <Label Text="Drag the slider to change this text size!"
               FontSize="{Binding FontSize}"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

            <!-- Slider bound to the same FontSize property -->
            <Slider Minimum="10"
                Maximum="50"
                Value="{Binding FontSize, Mode=TwoWay}" />

            <!-- Display the current font size value -->
            <Label Text="{Binding FontSize, StringFormat='Current Size: {0:F0}'}"
               HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>