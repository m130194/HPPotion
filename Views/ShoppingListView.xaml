<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HarryPotterPotions.Views.ShoppingListView"
             x:Name="WhatsThisShoppingListPage"
             Title="Shopping List">
    <VerticalStackLayout>


            <CollectionView ItemsSource="{Binding SavedPotions}" x:Name="SavedPotionsList">
                <CollectionView.EmptyView>
                    <Label Text="No saved potions." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout>
                            <Label Text="{Binding Name}" />

                            <Label Text="{Binding Ingredients}" />

                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


    </VerticalStackLayout>
</ContentPage>