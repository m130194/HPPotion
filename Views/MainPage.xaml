<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:Models="clr-namespace:HarryPotterPotions.Models"
             xmlns:ViewModels="clr-namespace:HarryPotterPotions.ViewModels"
             x:Name="ThisMainPage"
             x:Class="HarryPotterPotions.Views.MainPage"
             x:DataType="ViewModels:PotionsViewModel"
             Title="Search Potions">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Entry Text="{Binding SearchParam}" />

            <Button x:Name="ButtonSearch" Text="Search" Command="{Binding ButtonSearchCommand}" />

            <CollectionView ItemsSource="{Binding PotionSearchResults}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="Models:Potion">
                        <HorizontalStackLayout>
                            <Label
                                Text="{Binding Name}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference ThisMainPage}, Path=BindingContext.TapAddPotionCommand}"
                                                          CommandParameter="{Binding .}"
                                      NumberOfTapsRequired="1" />
                                </Label.GestureRecognizers>
                            </Label>


                            <!--<Button
                                Text="Select"
                                Command="{Binding Source={x:Reference MainPage}, Path=BindingContext.SetSelectedPotionCommand}"
                                CommandParameter="{Binding .}" />-->

                            <!--<Label Text="{Binding Ingredients}" />-->

                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Add Potion to Saved Potions" Command="{Binding ButtonAddPotionCommand}" />

            <CollectionView ItemsSource="{Binding SavedPotionsToMake}">
                <CollectionView.EmptyView>
                    <Label Text="No saved potions." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="Models:Potion">
                        <HorizontalStackLayout>
                            <Label Text="{Binding Name}" />
                            <Button Text="Delete" Command="{Binding Source={x:Reference ThisMainPage}, Path=BindingContext.DeletePotionCommand}" CommandParameter="{Binding .}" BackgroundColor="Red" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Go to Shopping List" Clicked="OnGoToShoppingListClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
