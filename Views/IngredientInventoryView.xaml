<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:HarryPotterPotions.Models"
             xmlns:viewmodel="clr-namespace:HarryPotterPotions.ViewModels"
             x:DataType="viewmodel:IngredientInventoryViewModel"
             
             x:Class="HarryPotterPotions.Views.IngredientInventoryView"
             Title="IngredientInventoryView">
    <ScrollView>
        <VerticalStackLayout>
        <Entry x:Name="EntryQuantity" />
        <Entry x:Name="EntryName" />
        <Button Text="Save" Command="{Binding ButtonSaveCommand}"/>
        <Button Text="Refresh" Command="{Binding ButtonRefreshCommand}"/>
            <CollectionView x:Name="ListViewIngredients" ItemsSource="{Binding Inventory}">
                <CollectionView.EmptyView>
                    <Label Text="No saved inventory." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Ingredient">
                        <VerticalStackLayout>
                            <Label Text="{Binding ID}"/>
                            <Label Text="{Binding Name}"/>
                            <Label Text="{Binding Quantity}"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView>
                <CollectionView.ItemsSource>
                    <x:Array Type="{x:Type models:Ingredient}">
                        <models:Ingredient Name="Veritaserum" Quantity="5" />
                        <models:Ingredient Name="Wolfsbane" Quantity="10" />
                    </x:Array>
                </CollectionView.ItemsSource>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Ingredient">
                        <HorizontalStackLayout Padding="10" Spacing="10">
                            <Label Text="{Binding Name}" FontSize="20"/>
                            <Label Text="{Binding Quantity}" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
        </ScrollView>
</ContentPage>