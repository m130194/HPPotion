<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:HarryPotterPotions.Models"
             xmlns:viewmodel="clr-namespace:HarryPotterPotions.ViewModels"
             x:DataType="viewmodel:InventoryViewModel"
             
             x:Class="HarryPotterPotions.Views.IngredientInventoryPage"
             x:Name="ThisIngredientInventory"
             Title="Ingredient Inventory">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="StackLayout" x:Name="MyStackLayoutStyle">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <VisualState x:Name="Portrait">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Portrait" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="Orientation" Value="Vertical" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Landscape">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Landscape" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="Orientation" Value="Horizontal" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <!--GridStyle-->
            <Style TargetType="Grid" x:Name="MyGridStyle">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <VisualState x:Name="Portrait">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Portrait" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="RowDefinitions" Value="*" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Landscape">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Landscape" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="ColumnDefinitions" Value="*,*,*" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>
        <StackLayout
            Orientation="Vertical"
            Style="{StaticResource MyStackLayoutStyle}">


            <SearchBar Text="{Binding SearchText, Mode=TwoWay}" />
            <Button Text="Search" Command="{Binding SearchCommand}" MaximumWidthRequest="200"/>
            <Button Text="See all ingredients" Command="{Binding ButtonRefreshCommand}" WidthRequest="300"/>

            <CollectionView ItemsSource="{Binding Inventory}">
                <CollectionView.EmptyView>
                    <Label Text="No such ingredient found." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Ingredient">
                        <Grid RowDefinitions="*"
ColumnDefinitions="*,*,*,3*,*"
RowSpacing="10"
ColumnSpacing="10"
Margin="10"
Padding="10">


                            <Button Text="Save" x:Name="SaveQuantityButton" Command="{Binding Source={x:Reference ThisIngredientInventory}, Path=BindingContext.EditQuantityCommand}" CommandParameter="{Binding .}" Grid.Column="0" Grid.Row="0"/>
                            <Stepper Value="{Binding Quantity, Mode=TwoWay}" Increment="1" Minimum="0" x:Name="QuantityStepper" Grid.Column="1" Grid.Row="0"/>
                            <Label Text="{Binding Source={x:Reference QuantityStepper}, Path=Value}" Grid.Column="2" Grid.Row="0"/>
                            <!--<Entry Placeholder="{Binding Quantity}" Text="{Binding Source={x:Reference ThisIngredientInventory}, Mode=TwoWay, Path=CommandParameter.Quantity}" Grid.Column="1" Grid.Row="0"/>-->
                            <Label Text="{Binding Name}" Grid.Column="3" Grid.Row="0"/>
                            <Button Text="Delete" Command="{Binding Source={x:Reference ThisIngredientInventory}, Path=BindingContext.ButtonDeleteCommand}" CommandParameter="{Binding .}" Grid.Column="4" Grid.Row="0"/>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </StackLayout>
    </ScrollView>
</ContentPage>